{
  "framework": "nextjs",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/paginas-legais/termos-de-uso.html", "destination": "/termos-de-uso", "permanent": true },
    { "source": "/paginas-legais/politica-de-privacidade.html", "destination": "/politica-de-privacidade", "permanent": true },
    { "source": "/paginas-legais/exclusao-de-dados.html", "destination": "/exclusao-de-dados", "permanent": true },
    { "source": "/termos-de-uso.html", "destination": "/termos-de-uso", "permanent": true },
    { "source": "/politica-de-privacidade.html", "destination": "/politica-de-privacidade", "permanent": true },
    { "source": "/exclusao-de-dados.html", "destination": "/exclusao-de-dados", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/crm/site/index.html" },
    { "source": "/termos-de-uso", "destination": "/crm/site/termos-de-uso.html" },
    { "source": "/politica-de-privacidade", "destination": "/crm/site/politica-de-privacidade.html" },
    { "source": "/exclusao-de-dados", "destination": "/crm/site/exclusao-de-dados.html" },
    { "source": "/assets/:path*", "destination": "/crm/site/assets/:path*" }
  ],
  "crons": [
    {
      "path": "/crm/api/funnels/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/crm/api/integrations/instagram/check-tokens",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/crm/api/cron/evolution-reconcile",
      "schedule": "* * * * *"
    }
  ]
}
